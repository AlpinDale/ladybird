dictionary GPUCopyExternalImageSourceInfo {
    required ImageBitmap source;
};

dictionary GPUCopyExternalImageDestInfo {
    required GPUTexture texture;
};

[SecureContext, Exposed=(Window,Worker), ImplementedIn=Rust]
interface GPUQueue {
    undefined submit(sequence<GPUCommandBuffer> commandBuffers);
    Promise<undefined> onSubmittedWorkDone();
    undefined writeBuffer(GPUBuffer buffer, unsigned long long bufferOffset, [AllowShared] BufferSource data);
    undefined copyExternalImageToTexture(GPUCopyExternalImageSourceInfo source, GPUCopyExternalImageDestInfo destination, sequence<unsigned long> copySize);
};
